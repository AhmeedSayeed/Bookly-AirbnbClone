@model BLL.ViewModels.Reviews.HostResponseViewModel

@{
    ViewData["Title"] = Localizer["RespondToReview"];
}

<div style="max-width: 600px; margin: 0 auto; padding: var(--space-6) var(--gutter);">

    <h1 class="font-display" style="font-size: var(--fs-xl); margin-bottom: var(--space-6);">
        @Localizer["RespondToReview"]
    </h1>

    <!-- The original review, for context -->
    <div style="background: var(--color-surface-sunk); border-radius: var(--radius-md); padding: var(--space-4); margin-bottom: var(--space-6);">
        <div style="display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-2);">
            <strong>@Model.Review.GuestName</strong>
            <span style="color: var(--color-brass);">&#9733; @Model.Review.Rating</span>
        </div>
        @if (!string.IsNullOrEmpty(Model.Review.Comment))
        {
            <p style="color: var(--color-text); margin: 0;">@Model.Review.Comment</p>
        }
    </div>

    <div asp-validation-summary="ModelOnly" style="color: var(--color-danger); margin-bottom: var(--space-4);"></div>

    <form asp-action="Respond" method="post">
        <input type="hidden" asp-for="ReviewId" />
        <input type="hidden" asp-for="ListingId" />

        <div style="margin-bottom: var(--space-6);">
            <label style="font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted); display: block; margin-bottom: var(--space-2);">
                @Localizer["YourResponse"]
            </label>
            <textarea asp-for="ResponseText" rows="4" maxlength="1000"
                      style="width: 100%; padding: var(--space-3); border-radius: var(--radius-sm); border: 1px solid var(--color-border); font-family: var(--font-body); resize: vertical;"></textarea>
            <span asp-validation-for="ResponseText" style="color: var(--color-danger); font-size: var(--fs-sm);"></span>
        </div>

        <button type="submit" class="btn-primary">
            @Localizer["PostResponse"]
        </button>
    </form>
</div>
