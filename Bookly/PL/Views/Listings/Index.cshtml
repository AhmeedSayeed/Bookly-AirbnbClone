@model PagedResult<ListingCardDto>

@{
    ViewData["Title"] = "Search Stays";
    var currentSearch = ViewBag.CurrentSearch as ListingSearchRequestDto;
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div style="max-width: var(--content-max); margin: 0 auto; padding: 0 var(--gutter); display: grid; grid-template-columns: 300px 1fr; gap: var(--space-6); margin-top: var(--space-6);">
    
    <!-- SEARCH SIDEBAR -->
    <aside>
        <form method="get" asp-action="Index" style="padding: var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-md);">
            <h2 class="font-display" style="font-size: var(--fs-md); margin-bottom: var(--space-4);">Filters</h2>
            
            <div class="form-group" style="margin-bottom: var(--space-3);">
                <label style="font-size: var(--fs-xs); text-transform: uppercase; color: var(--color-text-muted);">City</label>
                <input type="text" name="City" value="@currentSearch?.City" class="form-control" style="width: 100%; padding: var(--space-2); border-radius: var(--radius-sm); border: 1px solid var(--color-border);" />
            </div>

            <div class="form-group" style="margin-bottom: var(--space-3);">
                <label style="font-size: var(--fs-xs); text-transform: uppercase; color: var(--color-text-muted);">Price Range ($)</label>
                <div style="display: flex; gap: var(--space-2);">
                    <input type="number" name="MinPrice" value="@currentSearch?.MinPrice" placeholder="Min" class="form-control" style="width: 50%; padding: var(--space-2); border-radius: var(--radius-sm); border: 1px solid var(--color-border);" />
                    <input type="number" name="MaxPrice" value="@currentSearch?.MaxPrice" placeholder="Max" class="form-control" style="width: 50%; padding: var(--space-2); border-radius: var(--radius-sm); border: 1px solid var(--color-border);" />
                </div>
            </div>

            <div style="margin-top: var(--space-4);">
                <label style="font-size: var(--fs-xs); text-transform: uppercase; color: var(--color-text-muted); display: block; margin-bottom: var(--space-2);">Amenities</label>
                @if (ViewBag.Amenities != null)
                {
                    foreach (var amenity in ViewBag.Amenities)
                    {
                        var isChecked = currentSearch?.AmenityIds != null && currentSearch.AmenityIds.Contains(amenity.Id);
                        <label style="display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-1); cursor: pointer;">
                            <input type="checkbox" name="AmenityIds" value="@amenity.Id" @(isChecked ? "checked" : "") />
                            <span style="font-size: var(--fs-sm);">@amenity.Name</span>
                        </label>
                    }
                }
            </div>

            <button type="submit" class="btn-primary" style="width: 100%; margin-top: var(--space-4); border-radius: var(--radius-pill);">Apply Filters</button>
        </form>
    </aside>

    <!-- RESULTS GRID -->
    <div>
        <div id="map" style="height: 350px; border-radius: var(--radius-md); margin-bottom: var(--space-5); border: 1px solid var(--color-border);"></div>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-5);">
            @if (Model.Items != null && Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    <a asp-action="Details" asp-route-id="@item.Id" style="text-decoration: none; color: inherit;">
                        <div class="listing-card">
                            <img src="@(string.IsNullOrEmpty(item.ThumbnailUrl) ? "/images/placeholder.jpg" : item.ThumbnailUrl)" alt="@item.Title" />
                            <div style="padding: var(--space-3);">
                                <h3 class="font-display" style="font-size: var(--fs-md); margin-bottom: var(--space-1);">@item.City</h3>
                                <p style="font-size: var(--fs-sm); color: var(--color-text-muted); margin-bottom: var(--space-2);">@item.Title</p>
                                <p class="font-display" style="font-weight: 700; color: var(--color-navy);">@item.PricePerNight.ToString("C") <span style="font-weight: 400; font-size: var(--fs-sm); color: var(--color-text-muted); font-family: var(--font-body);">night</span></p>
                            </div>
                        </div>
                    </a>
                }
            }
            else
            {
                <div style="grid-column: 1 / -1; text-align: center; padding: var(--space-8) 0;">
                    <h2 class="font-display" style="font-size: var(--fs-lg);">No places found</h2>
                    <p style="color: var(--color-text-muted);">Try adjusting your search filters.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const listings = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items));
        const map = L.map('map').setView([30.0444, 31.2357], 11);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);
        const markers = [];
        listings.forEach(item => {
            if (item.Latitude && item.Longitude) {
                const marker = L.marker([item.Latitude, item.Longitude]).addTo(map);

                marker.bindPopup(`
                            <div style="font-size: 13px; font-family: sans-serif;">
                                <b>${item.Title}</b><br/>
                                <span>$${item.PricePerNight} / night</span><br/>
                                <a href="/Listings/Details/${item.Id}" style="color: #B08D57; font-weight: bold; text-decoration: none;">View Details &rarr;</a>
                            </div>
                        `);

                markers.push(marker);
            }
        });
        if (markers.length > 0) {
            const group = new L.featureGroup(markers);
            map.fitBounds(group.getBounds().pad(0.1));
        }
    </script>
}