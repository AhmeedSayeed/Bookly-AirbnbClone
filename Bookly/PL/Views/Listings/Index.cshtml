@model DAL.Models.Common.PagedResult<BLL.DTOs.Listing.ListingCardDto>

@{
    ViewData["Title"] = Localizer["SearchStays"];
    var currentSearch = ViewBag.CurrentSearch as BLL.DTOs.Listing.ListingSearchRequestDto;
    var isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;

    decimal siteMinPrice = ViewBag.MinAvailablePrice != null ? (decimal)ViewBag.MinAvailablePrice : 0;
    decimal siteMaxPrice = ViewBag.MaxAvailablePrice != null ? (decimal)ViewBag.MaxAvailablePrice : 2000;
    if (siteMinPrice == siteMaxPrice) { siteMaxPrice = siteMinPrice + 500; }

    decimal currentMinPrice = currentSearch?.MinPrice ?? siteMinPrice;
    decimal currentMaxPrice = currentSearch?.MaxPrice ?? siteMaxPrice;
}

@if (isAuthenticated)
{
    @Html.AntiForgeryToken()
}

<style>
    .pill-group {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin-top: var(--space-2);
    }

    .pill-radio {
        display: none;
    }

    .pill-label {
        padding: var(--space-2) var(--space-3);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-pill);
        font-size: var(--fs-xs);
        cursor: pointer;
        transition: all 0.2s ease;
        background: var(--color-surface);
        color: var(--color-text);
        user-select: none;
    }

    .pill-radio:checked + .pill-label {
        background: var(--color-navy);
        color: var(--color-surface);
        border-color: var(--color-navy);
    }

    .checkbox-group {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        margin-top: var(--space-2);
    }

    /* Dual range slider - both thumbs are perfectly centered on the track */
    .dual-range-container {
        position: relative;
        height: 32px;
        margin-top: var(--space-3);
        width: 100%;
    }

        .dual-range-container input[type="range"] {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 32px;
            margin: 0;
            padding: 0;
            background: transparent;
            pointer-events: none;
            appearance: none;
            -webkit-appearance: none;
            z-index: 3;
        }

            /* WebKit browsers: Chrome, Edge, Safari */
            .dual-range-container input[type="range"]::-webkit-slider-runnable-track {
                height: 6px;
                background: transparent;
                border: none;
                border-radius: var(--radius-pill);
            }

            .dual-range-container input[type="range"]::-webkit-slider-thumb {
                pointer-events: auto;
                appearance: none;
                -webkit-appearance: none;
                width: 18px;
                height: 18px;
                border-radius: 50%;
                background: var(--color-navy);
                border: 2px solid var(--color-surface);
                cursor: pointer;
                box-shadow: var(--shadow-sm);

                /* (18px thumb - 6px track) / 2 = 6px */
                margin-top: -6px;
            }

            /* Firefox */
            .dual-range-container input[type="range"]::-moz-range-track {
                height: 6px;
                background: transparent;
                border: none;
                border-radius: var(--radius-pill);
            }

            .dual-range-container input[type="range"]::-moz-range-thumb {
                pointer-events: auto;
                width: 18px;
                height: 18px;
                border-radius: 50%;
                background: var(--color-navy);
                border: 2px solid var(--color-surface);
                cursor: pointer;
                box-shadow: var(--shadow-sm);
            }

    /* The background track is exactly centered inside the 32px slider area */
    .range-track {
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 100%;
        height: 6px;
        background: var(--color-border);
        border-radius: var(--radius-pill);
        z-index: 1;
    }

    /* Selected range is centered on the exact same horizontal axis */
    .range-track-highlight {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        height: 6px;
        background: var(--color-navy);
        border-radius: var(--radius-pill);
        z-index: 2;
        pointer-events: none;
    }

    .price-values-display {
        display: flex;
        justify-content: space-between;
        font-size: var(--fs-xs);
        color: var(--color-text-muted);
        margin-top: var(--space-2);
    }

    .custom-range {
        width: 100%;
    }
</style>

<div style="max-width: var(--content-max); margin: 0 auto; padding: 0 var(--gutter); display: grid; grid-template-columns: 300px 1fr; gap: var(--space-6); margin-top: var(--space-6);">

    <!-- SEARCH SIDEBAR -->
    <aside>
        <form method="get" asp-action="Index" style="padding: var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-md); position: sticky; top: 100px; background: var(--color-surface);">

            <h2 class="font-display" style="font-size: var(--fs-md); margin-bottom: var(--space-4);">
                @Localizer["Filters"]
            </h2>

            <!-- Main Search Term (Omnibox - matches Home Page) -->
            <div class="form-group" style="margin-bottom: var(--space-5);">
                <label style="font-size: var(--fs-xs); text-transform: uppercase; color: var(--color-text-muted);">
                    @Localizer["WhatAreYouLookingFor"]
                </label>
                <input type="text" name="SearchTerm" value="@currentSearch?.SearchTerm" class="form-control" placeholder="@Localizer["SearchPlaceholderExpressive"]" style="width: 100%; padding: var(--space-2); border-radius: var(--radius-sm); border: 1px solid var(--color-border); margin-top: var(--space-2);" />
            </div>

            <!-- Dual Price Range Slider (Native HTML5 with Highlight Track) -->
            <div class="form-group" style="margin-bottom: var(--space-5);">
                <label style="font-size: var(--fs-xs); text-transform: uppercase; color: var(--color-text-muted);">
                    @Localizer["PriceRange"]
                </label>

                <div class="dual-range-container">
                    <div class="range-track"></div>
                    <div id="range-highlight" class="range-track-highlight"></div>
                    <input type="range"
                           name="MinPrice"
                           id="min-price-range"
                           min="@siteMinPrice"
                           max="@siteMaxPrice"
                           step="10"
                           value="@currentMinPrice"
                           class="custom-range"
                           oninput="updateRange()" />

                    <input type="range"
                           name="MaxPrice"
                           id="max-price-range"
                           min="@siteMinPrice"
                           max="@siteMaxPrice"
                           step="10"
                           value="@currentMaxPrice"
                           class="custom-range"
                           oninput="updateRange()" />
                </div>

                <div class="price-values-display">
                    <span>$<span id="min-price-val">@currentMinPrice</span></span>
                    <span>$<span id="max-price-val">@currentMaxPrice</span></span>
                </div>
            </div>

            <!-- Guests Range -->
            <div class="form-group" style="margin-bottom: var(--space-5);">
                <label style="font-size: var(--fs-xs); text-transform: uppercase; color: var(--color-text-muted);">@Localizer["Guests"]</label>
                <div class="pill-group">
                    @foreach (var range in new[] { "1-3", "4-5", "6-10", "10+" })
                    {
                        var isChecked = currentSearch?.GuestsRange == range;
                        <input type="radio" name="GuestsRange" id="guests-@range" value="@range" class="pill-radio toggleable-pill" @(isChecked ? "checked" : "") />
                        <label for="guests-@range" class="pill-label">@range</label>
                    }
                </div>
            </div>

            <!-- Bedrooms Range -->
            <div class="form-group" style="margin-bottom: var(--space-5);">
                <label style="font-size: var(--fs-xs); text-transform: uppercase; color: var(--color-text-muted);">@Localizer["Bedrooms"]</label>
                <div class="pill-group">
                    @foreach (var range in new[] { "1-2", "3-4", "5-6", "6+" })
                    {
                        var isChecked = currentSearch?.BedroomsRange == range;
                        <input type="radio" name="BedroomsRange" id="beds-@range" value="@range" class="pill-radio toggleable-pill" @(isChecked ? "checked" : "") />
                        <label for="beds-@range" class="pill-label">@range</label>
                    }
                </div>
            </div>

            <!-- Property Types -->
            <div class="form-group" style="margin-bottom: var(--space-5);">
                <label style="font-size: var(--fs-xs); text-transform: uppercase; color: var(--color-text-muted);">@Localizer["PropertyType"]</label>
                <div class="checkbox-group">
                    @foreach (var type in Enum.GetNames(typeof(DAL.Enums.PropertyType)))
                    {
                        var isChecked = currentSearch?.PropertyTypes != null && currentSearch.PropertyTypes.Contains(type);
                        <label style="display: flex; align-items: center; gap: var(--space-2); cursor: pointer; font-size: var(--fs-sm);">
                            <input type="checkbox" name="PropertyTypes" value="@type" @(isChecked ? "checked" : "") />
                            @Localizer[type]
                        </label>
                    }
                </div>
            </div>

            <!-- Amenities -->
            <div class="form-group" style="margin-bottom: var(--space-5);">
                <label style="font-size: var(--fs-xs); text-transform: uppercase; color: var(--color-text-muted);">@Localizer["Amenities"]</label>
                <div class="checkbox-group">
                    @if (ViewBag.Amenities != null)
                    {
                        foreach (var amenity in ViewBag.Amenities)
                        {
                            var isChecked = currentSearch?.AmenityIds != null && currentSearch.AmenityIds.Contains(amenity.Id);
                            <label style="display: flex; align-items: center; gap: var(--space-2); cursor: pointer; font-size: var(--fs-sm);">
                                <input type="checkbox" name="AmenityIds" value="@amenity.Id" @(isChecked ? "checked" : "") />
                                @amenity.Name
                            </label>
                        }
                    }
                </div>
            </div>

            <!-- Cancellation Policy -->
            <div class="form-group" style="margin-bottom: var(--space-5);">
                <label style="font-size: var(--fs-xs); text-transform: uppercase; color: var(--color-text-muted);">@Localizer["CancellationPolicy"]</label>
                <div class="checkbox-group">
                    @foreach (var policy in Enum.GetNames(typeof(DAL.Enums.CancellationPolicy)))
                    {
                        var isChecked = currentSearch?.CancellationPolicies != null && currentSearch.CancellationPolicies.Contains(policy);
                        <label style="display: flex; align-items: center; gap: var(--space-2); cursor: pointer; font-size: var(--fs-sm);">
                            <input type="checkbox" name="CancellationPolicies" value="@policy" @(isChecked ? "checked" : "") />
                            @Localizer[policy]
                        </label>
                    }
                </div>
            </div>

            <button type="submit" class="btn-primary" style="width: 100%; padding: var(--space-3); border-radius: var(--radius-pill); background: var(--color-navy); color: var(--color-surface); font-weight: 600; border: none; cursor: pointer;">
                @Localizer["ApplyFilters"]
            </button>

            <a asp-action="Index" style="display: block; text-align: center; margin-top: var(--space-3); font-size: var(--fs-xs); color: var(--color-text-muted); text-decoration: underline;">
                @Localizer["ClearFilters"]
            </a>

        </form>
    </aside>

    <!-- RESULTS GRID -->
    <div>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-5); margin-bottom: var(--space-8);">

            @if (Model.Items != null && Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    <div class="listing-card" data-listing-id="@item.Id" style="display: flex; flex-direction: column; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); transition: transform var(--duration-fast), box-shadow var(--duration-fast); height: 100%;">

                        <!-- Constrained Image Container -->
                        <div style="position: relative; padding-top: 66.66%; overflow: hidden; background: var(--color-surface-sunk);">
                            <a asp-action="Details" asp-route-id="@item.Id">
                                <img src="@(string.IsNullOrEmpty(item.ThumbnailUrl) ? "/images/placeholder.jpg" : item.ThumbnailUrl)"
                                     alt="@item.Title"
                                     style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" />
                            </a>

                            @if (isAuthenticated)
                            {
                                <button type="button"
                                        class="wishlist-toggle-btn"
                                        data-listing-id="@item.Id"
                                        title="@Localizer["Wishlist"]"
                                        style="position: absolute; top: var(--space-2); right: var(--space-2);
                                    width: 60px; height: 60px; border-radius: var(--radius-pill);
                                    border: none; background: rgba(255,255,255,0.85);
                                    display: flex; align-items: center; justify-content: center;
                                    cursor: pointer; z-index: 2;">
                                    <span class="wishlist-heart-icon"
                                          style="color: @(item.IsWishlisted ? "#8B1E1E" : "var(--color-clay)"); font-size: 38px; line-height: 1;">&#9829;</span>
                                </button>
                            }
                        </div>

                        <!-- Card Data -->
                        <a asp-action="Details" asp-route-id="@item.Id" style="text-decoration: none; color: inherit; display: flex; flex-direction: column; flex-grow: 1;">
                            <div style="padding: var(--space-3); display: flex; flex-direction: column; flex-grow: 1;">

                                <h3 class="font-display" style="font-size: var(--fs-md); margin: 0 0 var(--space-1) 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    @item.City
                                </h3>

                                <p style="font-size: var(--fs-sm); color: var(--color-text-muted); margin: 0 0 var(--space-2) 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; flex-grow: 1;">
                                    @item.Title
                                </p>

                                <p class="font-display" style="font-weight: 700; color: var(--color-navy); margin: 0; margin-top: auto;">
                                    @item.PricePerNight.ToString("C")
                                    <span style="font-weight: 400; font-size: var(--fs-sm); color: var(--color-text-muted); font-family: var(--font-body);">
                                        @Localizer["Night"]
                                    </span>
                                </p>
                            </div>
                        </a>
                    </div>
                }
            }
            else
            {
                <div style="grid-column: 1 / -1; text-align: center; padding: var(--space-8) 0;">
                    <h2 class="font-display" style="font-size: var(--fs-lg); color: var(--color-navy); margin-bottom: var(--space-2);">
                        @Localizer["NoPlacesFound"]
                    </h2>
                    <p style="color: var(--color-text-muted);">
                        @Localizer["TryAdjustingSearchFilters"]
                    </p>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateRange() {
            var minInput = document.getElementById('min-price-range');
            var maxInput = document.getElementById('max-price-range');
            var minVal = parseInt(minInput.value);
            var maxVal = parseInt(maxInput.value);
            var minSpan = document.getElementById('min-price-val');
            var maxSpan = document.getElementById('max-price-val');
            var highlight = document.getElementById('range-highlight');

            if (minVal > maxVal) {
                var tmp = minVal;
                minInput.value = maxVal;
                maxInput.value = tmp;
                minVal = parseInt(minInput.value);
                maxVal = parseInt(maxInput.value);
            }

            minSpan.textContent = minVal;
            maxSpan.textContent = maxVal;

            var minLimit = parseFloat(minInput.min) || 0;
            var maxLimit = parseFloat(minInput.max) || 2000;
            var rangeSpan = maxLimit - minLimit;

            var minPercent = rangeSpan > 0 ? ((minVal - minLimit) / rangeSpan) * 100 : 0;
            var maxPercent = rangeSpan > 0 ? ((maxVal - minLimit) / rangeSpan) * 100 : 100;

            highlight.style.left = minPercent + '%';
            highlight.style.width = (maxPercent - minPercent) + '%';
        }

        document.addEventListener("DOMContentLoaded", function() {
            updateRange();

            // Toggleable Radio Pills Logic (Click active pill to uncheck)
            document.querySelectorAll('.toggleable-pill').forEach(function(radio) {
                radio.addEventListener('click', function(e) {
                    if (this.dataset.wasChecked === 'true') {
                        this.checked = false;
                        this.dataset.wasChecked = 'false';
                    } else {
                        document.querySelectorAll('input[name="' + this.name + '"]').forEach(function(r) {
                            r.dataset.wasChecked = 'false';
                        });
                        this.checked = true;
                        this.dataset.wasChecked = 'true';
                    }
                });

                if (radio.checked) {
                    radio.dataset.wasChecked = 'true';
                } else {
                    radio.dataset.wasChecked = 'false';
                }
            });
        });
    </script>

    @if (isAuthenticated)
    {
        <script>
            document.querySelectorAll('.wishlist-toggle-btn').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();

                    var listingId = btn.getAttribute('data-listing-id');
                    var icon = btn.querySelector('.wishlist-heart-icon');

                    fetch('@Url.Action("Toggle", "Wishlist")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: 'listingId=' + encodeURIComponent(listingId)
                    })
                        .then(function(res) { return res.json(); })
                        .then(function(data) {
                            if (data.success) {
                                icon.style.color = data.isWishlisted ? '#8B1E1E' : 'var(--color-clay)';
                            }
                        });
                });
            });
        </script>
    }
}