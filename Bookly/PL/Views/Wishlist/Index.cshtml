@model BLL.ViewModels.Wishlist.WishlistViewModel

@{
    ViewData["Title"] = Localizer["Wishlist"];
}

<div style="max-width: var(--content-max); margin: 0 auto; padding: var(--space-6) var(--gutter);">

    <h1 class="font-display" style="font-size: var(--fs-xl); margin-bottom: var(--space-6);">
        @Localizer["Wishlist"]
    </h1>

    @if (Model == null || !Model.Listings.Any())
    {
        <div style="text-align: center; padding: var(--space-8) 0;">
            <p class="font-display" style="font-size: var(--fs-lg); color: var(--color-text);">
                @Localizer["NoSavedListingsYet"]
            </p>
            <p style="color: var(--color-text-muted); margin-top: var(--space-2);">
                @Localizer["TapHeartToSave"]
            </p>
            <a asp-controller="Listings" asp-action="Index"
               class="btn-primary"
               style="display: inline-block; margin-top: var(--space-5); text-decoration: none;">
                @Localizer["ExploreListings"]
            </a>
        </div>
    }
    else
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-5);">
            @foreach (var listing in Model.Listings)
            {
                <div class="listing-card" data-listing-id="@listing.Id">
                    <div style="position: relative;">
                        <a asp-controller="Listings" asp-action="Details" asp-route-id="@listing.Id">
                            <img src="@(listing.PrimaryPhotoUrl ?? "/images/placeholder.jpg")"
                                 alt="@listing.Title"
                                 class="listing-card__image" />
                        </a>

                        <button type="button"
                                class="wishlist-toggle-btn"
                                data-listing-id="@listing.Id"
                                title="@Localizer["RemoveFromWishlist"]"
                                style="position: absolute; top: var(--space-3); right: var(--space-3);
                            width: 60px; height: 60px; border-radius: var(--radius-pill);
                            border: none; background: rgba(255,255,255,0.85);
                            display: flex; align-items: center; justify-content: center;
                            cursor: pointer;">
                            <span class="wishlist-heart-icon" style="color: #8B1E1E; font-size: 38px; line-height: 1;">&#9829;</span>
                        </button>
                    </div>

                    <div class="listing-card__body">
                        <div class="listing-card__title">@listing.Title</div>
                        <div class="listing-card__location">@listing.City, @listing.Country</div>

                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: var(--space-2);">
                            <span class="listing-card__price">
                                @listing.PricePerNight.ToString("C")
                                <span style="font-family: var(--font-body); font-weight: 400; font-size: var(--fs-sm); color: var(--color-text-muted);">
                                    / @Localizer["Night"]
                                </span>
                            </span>

                            @if (listing.ReviewCount > 0)
                            {
                                <span style="font-size: var(--fs-sm); color: var(--color-brass);">
                                    &#9733; @listing.AverageRating.ToString("0.0")
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.wishlist-toggle-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var listingId = btn.getAttribute('data-listing-id');
                var card = btn.closest('.listing-card');

                fetch('@Url.Action("Toggle", "Wishlist")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: 'listingId=' + encodeURIComponent(listingId)
                })
                    .then(function(res) { return res.json(); })
                    .then(function(data) {
                        if (data.success && !data.isWishlisted) {
                            // Removed from wishlist -> fade the card out on this page
                            card.style.transition = 'opacity 0.25s ease';
                            card.style.opacity = '0';
                            setTimeout(function() { card.remove(); }, 250);
                        }
                    });
            });
        });
    </script>
}
