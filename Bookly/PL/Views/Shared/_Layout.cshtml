@using DAL.Models
@using DAL.Models.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using System.Globalization
@using System.Text.Json
@using PL
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> Localizer

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name"
      dir="@(CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "rtl" : "ltr")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bookly</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Sora:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="~/logo.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header style="background: var(--color-bg); position: sticky; top: 0; z-index: 100; border-bottom: 1px solid var(--color-border);">
        <div class="container" style="display: flex; justify-content: space-between; align-items: center; height: 72px;">
            <a href="/" style="text-decoration: none; display: flex; align-items: center;">
                <img src="~/logo.png" alt="Bookly" style="height: 140px; width: auto; object-fit: contain;" />
            </a>

            <nav style="display: flex; gap: var(--space-4); align-items: center;">
                <!-- Language Switcher -->
                <div style="display: flex; gap: var(--space-2); align-items: center;">
                    <form asp-controller="Language" asp-action="SetLanguage" method="post" style="display: inline;">
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button type="submit" name="culture" value="en-EG" style="border: none; background: none; cursor: pointer; font-family: var(--font-body);">English</button>
                    </form>
                    <span>|</span>
                    <form asp-controller="Language" asp-action="SetLanguage" method="post" style="display: inline;">
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button type="submit" name="culture" value="ar-EG" style="border: none; background: none; cursor: pointer; font-family: var(--font-body);">العربية</button>
                    </form>
                </div>

                @if (User.Identity.IsAuthenticated)
                {
                    var currentUser = await UserManager.GetUserAsync(User);
                    var hasPhoto = !string.IsNullOrEmpty(currentUser?.ProfilePhotoUrl);
                    var firstInitial = !string.IsNullOrEmpty(currentUser?.FirstName) ? currentUser.FirstName.Substring(0, 1) : "";
                    var lastInitial = !string.IsNullOrEmpty(currentUser?.LastName) ? currentUser.LastName.Substring(0, 1) : "";
                    var initials = $"{firstInitial}{lastInitial}";

                    <!-- Notification Bell -->
                    <div class="nav-bell-container" style="position: relative;">
                        <a href="javascript:void(0);" class="nav-bell-wrapper" id="notificationBellToggle" onclick="toggleNotifications(event)">
                            <svg class="nav-bell-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                            </svg>
                            <span class="nav-bell-badge" id="notificationBadge" style="display:none;"></span>
                        </a>

                        <div class="notification-dropdown" id="notificationDropdown">
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--color-border);">
                                <strong style="font-size: var(--fs-sm); color: var(--color-navy);">@Localizer["Notifications"]</strong>
                                <a href="/Notifications" style="background: none; border: none; color: var(--color-brass); font-size: 12px; font-weight: 600; text-decoration: none;">@Localizer["ViewAll"]</a>
                            </div>
                            <div class="notification-list-body" id="notificationListBody">
                                <div style="padding: 20px; text-align: center; color: var(--color-text-muted); font-size: 13px;">@Localizer["Loading"]</div>
                            </div>
                        </div>
                    </div>

                    <div class="toast-container" id="toastContainer"></div>

                    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
                    <script>
                        window.booklyNotificationTemplates = @Html.Raw(JsonSerializer.Serialize(new
                        {
                            HostVerificationApprovedNotification = Localizer["HostVerificationApprovedNotification"].Value,
                            HostVerificationRejectedNotification = Localizer["HostVerificationRejectedNotification"].Value,
                            HostVerificationRejectedWithReason = Localizer["HostVerificationRejectedWithReason"].Value,
                            ListingDeactivatedNotification = Localizer["ListingDeactivatedNotification"].Value,
                             NewMessageFrom = Localizer["NewMessageFrom"].Value,
                        }));
                                        window.booklyI18n = {
                                            view: @Html.Raw(JsonSerializer.Serialize(Localizer["View"].Value)),
                                            loading: @Html.Raw(JsonSerializer.Serialize(Localizer["Loading"].Value)),
                                            noNotificationsFound: @Html.Raw(JsonSerializer.Serialize(Localizer["NoNotificationsFound"].Value)),
                                            failedToLoad: @Html.Raw(JsonSerializer.Serialize(Localizer["FailedToLoad"].Value))
                                        };
                    </script>

                    <!-- User Menu -->
                    <div class="user-menu-container" tabindex="0">
                        @if (hasPhoto)
                        {
                            <img src="@currentUser.ProfilePhotoUrl" alt="@Localizer["Profile"]" class="avatar" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                            <div class="avatar-initials" style="display: none;">@initials</div>
                        }
                        else
                        {
                            <div class="avatar-initials">@initials</div>
                        }

                        <div class="user-dropdown">
                            <a href="/Account/Profile" class="user-dropdown-item">@Localizer["AccountInfo"]</a>
                            <a asp-controller="Chat" asp-action="Inbox" class="user-dropdown-item">@Localizer["Messages"]</a>
                            <a href="/Listings/MyListings" class="user-dropdown-item">@Localizer["MyListings"]</a>
                            <a asp-controller="Bookings" asp-action="MyTrips" class="user-dropdown-item">@Localizer["MyTrips"]</a>
                            <a asp-controller="Wishlist" asp-action="Index" class="user-dropdown-item">@Localizer["MyWishlist"]</a>

                            @if (User.IsInRole("Host") || User.IsInRole("Admin"))
                            {
                                <a asp-controller="Bookings" asp-action="HostRequests" class="user-dropdown-item">@Localizer["HostDashboard"]</a>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <a href="/Admin/Dashboard" class="user-dropdown-item" style="color: var(--color-brass); font-weight: 600;">@Localizer["AdminDashboard"]</a>
                            }

                            <hr style="border: none; border-top: 1px solid var(--color-border); margin: 0;" />
                            <form asp-controller="Account" asp-action="Logout" method="post" style="margin: 0;">
                                <button type="submit" class="user-dropdown-item" style="color: var(--color-danger);">@Localizer["Logout"]</button>
                            </form>
                        </div>
                    </div>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Account" asp-action="BecomeAHost" style="font-family: var(--font-body); font-size: var(--fs-sm); font-weight: 600; color: var(--color-text); text-decoration: none; padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill); transition: background var(--duration-fast) var(--ease-smooth);">
                            @Localizer["HostYourHome"]
                        </a>
                    }
                }
                else
                {
                    <a href="/Account/Login" style="color: var(--color-text); text-decoration: none; font-weight: 500;">@Localizer["Login"]</a>
                    <a href="/Account/Register" class="btn-primary" style="padding: var(--space-2) var(--space-4);">@Localizer["SignUp"]</a>
                }
            </nav>
        </div>
    </header>

    <main class="container" style="padding-top: var(--space-6); padding-bottom: var(--space-8);">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/notifications.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>