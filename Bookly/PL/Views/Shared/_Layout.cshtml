@using DAL.Models
@using DAL.Models.Identity
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bookly</title>

    <!-- Load required Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Sora:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header style="background: var(--color-bg); position: sticky; top: 0; z-index: 100; border-bottom: 1px solid var(--color-border);">
        <div class="container" style="display: flex; justify-content: space-between; align-items: center; height: 72px;">
            <a href="/" style="text-decoration: none; color: var(--color-navy);">
                <h2 class="font-display" style="margin: 0; font-size: var(--fs-xl);">Bookly</h2>
            </a>

            <nav style="display: flex; gap: var(--space-4); align-items: center;">
                @if (User.Identity.IsAuthenticated)
                {
                    var currentUser = await UserManager.GetUserAsync(User);
                    var hasPhoto = !string.IsNullOrEmpty(currentUser?.ProfilePhotoUrl);

                    // Safely extract initials
                    var firstInitial = !string.IsNullOrEmpty(currentUser?.FirstName) ? currentUser.FirstName.Substring(0, 1) : "";
                    var lastInitial = !string.IsNullOrEmpty(currentUser?.LastName) ? currentUser.LastName.Substring(0, 1) : "";
                    var initials = $"{firstInitial}{lastInitial}";

                    <div class="user-menu-container" tabindex="0">

                        @if (hasPhoto)
                        {
                            <img src="@currentUser.ProfilePhotoUrl" alt="Profile" class="avatar" />
                        }
                        else
                        {
                            <div class="avatar-initials">@initials</div>
                        }

                        <div class="user-dropdown">
                            <a href="/Account/Profile" class="user-dropdown-item">Account Info</a>
                            <a href="/Listings/MyListings" class="user-dropdown-item">My Listings</a>
                            <hr style="border: none; border-top: 1px solid var(--color-border); margin: 0;" />
                            <form asp-controller="Account" asp-action="Logout" method="post" style="margin: 0;">
                                <button type="submit" class="user-dropdown-item" style="color: var(--color-danger);">Log out</button>
                            </form>
                        </div>
                    </div>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Account" asp-action="BecomeAHost" style="font-family: var(--font-body); font-size: var(--fs-sm); font-weight: 600; color: var(--color-text); text-decoration: none; padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill); transition: background var(--duration-fast) var(--ease-smooth);">
                            Host your home
                        </a>
                    }
                }
                else
                {
                    <a href="/Account/Login" style="color: var(--color-text); text-decoration: none; font-weight: 500;">Log in</a>
                    <a href="/Account/Register" class="btn-primary" style="padding: var(--space-2) var(--space-4);">Sign up</a>
                }
            </nav>
        </div>
    </header>

    <main class="container" style="padding-top: var(--space-6); padding-bottom: var(--space-8);">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>