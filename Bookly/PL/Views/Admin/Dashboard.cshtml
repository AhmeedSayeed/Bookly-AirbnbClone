@model AdminDashboardViewModel

@{
    ViewData["Title"] = Localizer["PlatformDashboard"];
}

<div style="max-width: var(--content-max); margin: 0 auto; padding: var(--space-6) var(--gutter);">

    <h1 class="font-display"
        style="font-size: var(--fs-xl); margin-bottom: var(--space-4);">
        @Localizer["DashboardOverview"]

    </h1>

    <partial name="_AdminNavigation" />

    @if (TempData["ErrorMessage"] != null)
    {
        <div style="padding: var(--space-3); background: rgba(155, 59, 52, 0.1); color: var(--color-danger); border-radius: var(--radius-sm); margin-bottom: var(--space-4);">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Metric Cards Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-5); margin-bottom: var(--space-8);">

        <div style="background: var(--color-surface); padding: var(--space-5); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); border: 1px solid var(--color-border);">
            <p style="font-size: var(--fs-sm); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: var(--space-2);">
                @Localizer["TotalUsers"]
            </p>
            <p class="font-display" style="font-size: var(--fs-xl); color: var(--color-navy); font-weight: 600;">
                @Model.TotalUsers
            </p>
        </div>

        <div style="background: var(--color-surface); padding: var(--space-5); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); border: 1px solid var(--color-border);">
            <p style="font-size: var(--fs-sm); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: var(--space-2);">
                @Localizer["TotalListings"]
            </p>
            <p class="font-display" style="font-size: var(--fs-xl); color: var(--color-navy); font-weight: 600;">
                @Model.TotalListings
            </p>
        </div>

        <div style="background: var(--color-surface); padding: var(--space-5); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); border: 1px solid var(--color-border);">
            <p style="font-size: var(--fs-sm); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: var(--space-2);">
                @Localizer["TotalBookings"]
            </p>
            <p class="font-display" style="font-size: var(--fs-xl); color: var(--color-navy); font-weight: 600;">
                @Model.TotalBookings
            </p>
        </div>

        <div style="background: var(--color-surface); padding: var(--space-5); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); border: 1px solid var(--color-border);">
            <p style="font-size: var(--fs-sm); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: var(--space-2);">
                @Localizer["Revenue"]
            </p>
            <p class="font-display" style="font-size: var(--fs-xl); color: var(--color-navy); font-weight: 600;">
                @Model.TotalRevenue.ToString("N2", System.Globalization.CultureInfo.InvariantCulture) @Localizer["CurrencyEGP"]
            </p>
        </div>

    </div>

    <!-- Recent Activity Feed -->
    <h2 class="font-display" style="font-size: var(--fs-lg); margin-bottom: var(--space-4);">
        @Localizer["RecentActivity"]
    </h2>

    <div style="background: var(--color-surface); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); border: 1px solid var(--color-border); padding: var(--space-4);">

        @if (Model.RecentActivity != null && Model.RecentActivity.Any())
        {
            <ul style="list-style: none; padding: 0; margin: 0;">
                @foreach (var activity in Model.RecentActivity)
                {
                    <li style="padding: var(--space-3) 0; border-bottom: 1px solid var(--color-border); font-size: var(--fs-sm); color: var(--color-text);">
                        <span style="color: var(--color-brass); margin-right: var(--space-2);">●</span>
                        @Localizer[activity.Type.ToString(), activity.Args]
                    </li>
                }
            </ul>
        }
        else
        {
            <p style="color: var(--color-text-muted); text-align: center; margin: var(--space-4) 0;">
                @Localizer["NoRecentActivity"]
            </p>
        }

    </div>

</div>