@model List<BLL.DTOs.CouponDto>

@{
    ViewData["Title"] = "Manage Coupons - Admin";
}

<div style="max-width: var(--content-max); margin: 0 auto; padding: var(--space-6) var(--gutter);">
    <h1 class="font-display" style="font-size: var(--fs-xl); margin-bottom: var(--space-4);">Coupon Management</h1>

    <!-- Admin Sub-Navigation -->
    <div style="display: flex; gap: var(--space-4); margin-bottom: var(--space-6); padding-bottom: var(--space-4); border-bottom: 1px solid var(--color-border); flex-wrap: wrap;">
        <a asp-controller="Admin" asp-action="Dashboard" style="color: var(--color-text); font-weight: 500; text-decoration: none; padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill); transition: background var(--duration-fast);">@Localizer["Overview"]</a>
        <a asp-controller="Admin" asp-action="Verifications" style="color: var(--color-text); font-weight: 500; text-decoration: none; padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill); transition: background var(--duration-fast);">@Localizer["ReviewIds"]</a>
        <a asp-controller="Admin" asp-action="Users" style="color: var(--color-text); font-weight: 500; text-decoration: none; padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill); transition: background var(--duration-fast);">@Localizer["ManageUsers"]</a>
        <a asp-controller="Admin" asp-action="Listings" style="color: var(--color-text); font-weight: 500; text-decoration: none; padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill); transition: background var(--duration-fast);">@Localizer["ModerateListings"]</a>
        <a asp-controller="Admin" asp-action="Coupons" style="color: var(--color-navy); font-weight: 600; text-decoration: none; padding: var(--space-2) var(--space-4); background: var(--color-surface-sunk); border-radius: var(--radius-pill);">Coupons</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="padding: var(--space-3); background: var(--color-surface-sunk); color: var(--color-success, #2e7d32); border-radius: var(--radius-sm); margin-bottom: var(--space-4); border: 1px solid var(--color-border);">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div style="padding: var(--space-3); background: rgba(155, 59, 52, 0.1); color: var(--color-danger); border-radius: var(--radius-sm); margin-bottom: var(--space-4); border: 1px solid var(--color-danger);">
            @TempData["ErrorMessage"]
        </div>
    }

    <div style="display: grid; grid-template-columns: 350px 1fr; gap: var(--space-6); align-items: start;">

        <!-- Create Coupon Form Card -->
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-5); box-shadow: var(--shadow-sm);">
            <h2 class="font-display" style="font-size: var(--fs-md); margin-bottom: var(--space-4); color: var(--color-navy);">Create New Coupon</h2>

            <form asp-controller="Admin" asp-action="CreateCoupon" method="post">
                @Html.AntiForgeryToken()

                <div class="form-group" style="margin-bottom: var(--space-3);">
                    <label class="form-label" style="font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; color: var(--color-text-muted); display: block; margin-bottom: var(--space-1);">Coupon Code</label>
                    <input type="text" name="Code" required placeholder="e.g. SUMMER25" class="form-control" style="text-transform: uppercase; font-family: var(--font-mono); font-weight: 600; width: 100%; padding: var(--space-2); border-radius: var(--radius-sm); border: 1px solid var(--color-border);" />
                </div>

                <div class="form-group" style="margin-bottom: var(--space-3);">
                    <label class="form-label" style="font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; color: var(--color-text-muted); display: block; margin-bottom: var(--space-1);">Discount Percent (%)</label>
                    <input type="number" name="DiscountPercent" min="1" max="100" required placeholder="e.g. 20" class="form-control" style="width: 100%; padding: var(--space-2); border-radius: var(--radius-sm); border: 1px solid var(--color-border);" />
                </div>

                <div class="form-group" style="margin-bottom: var(--space-3);">
                    <label class="form-label" style="font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; color: var(--color-text-muted); display: block; margin-bottom: var(--space-1);">Expiry Date</label>
                    <input type="datetime-local" name="ExpiryDate" required class="form-control" style="width: 100%; padding: var(--space-2); border-radius: var(--radius-sm); border: 1px solid var(--color-border);" />
                </div>

                <div class="form-group" style="margin-bottom: var(--space-4);">
                    <label class="form-label" style="font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; color: var(--color-text-muted); display: block; margin-bottom: var(--space-1);">Max Uses</label>
                    <input type="number" name="MaxUses" min="1" value="100" required class="form-control" style="width: 100%; padding: var(--space-2); border-radius: var(--radius-sm); border: 1px solid var(--color-border);" />
                </div>

                <button type="submit" class="btn-primary" style="width: 100%; padding: var(--space-3); border-radius: var(--radius-pill); background: var(--color-navy); color: var(--color-surface); font-weight: 600; border: none; cursor: pointer;">
                    Create Coupon
                </button>
            </form>
        </div>

        <!-- Coupons Table List -->
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); overflow: hidden;">
            <div style="padding: var(--space-4); border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center;">
                <h2 class="font-display" style="font-size: var(--fs-md); margin: 0; color: var(--color-navy);">Active & Expired Coupons</h2>
                <span style="font-size: var(--fs-xs); color: var(--color-text-muted);">Total: @(Model?.Count ?? 0)</span>
            </div>

            @if (Model != null && Model.Any())
            {
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: var(--fs-sm);">
                        <thead>
                            <tr style="background: var(--color-surface-sunk); border-bottom: 1px solid var(--color-border); color: var(--color-text-muted); font-size: var(--fs-xs); text-transform: uppercase;">
                                <th style="padding: var(--space-3) var(--space-4);">Code</th>
                                <th style="padding: var(--space-3) var(--space-4);">Discount</th>
                                <th style="padding: var(--space-3) var(--space-4);">Usage</th>
                                <th style="padding: var(--space-3) var(--space-4);">Expiry Date</th>
                                <th style="padding: var(--space-3) var(--space-4);">Status</th>
                                <th style="padding: var(--space-3) var(--space-4); text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var coupon in Model)
                            {
                                var isExpired = coupon.ExpiryDate < DateTime.UtcNow;
                                var isMaxReached = coupon.UsesCount >= coupon.MaxUses;

                                <tr style="border-bottom: 1px solid var(--color-border);">
                                    <td style="padding: var(--space-3) var(--space-4); font-family: var(--font-mono); font-weight: 700; color: var(--color-navy);">
                                        @coupon.Code
                                    </td>
                                    <td style="padding: var(--space-3) var(--space-4); font-weight: 600; color: var(--color-brass);">
                                        @coupon.DiscountPercent% OFF
                                    </td>
                                    <td style="padding: var(--space-3) var(--space-4);">
                                        @coupon.UsesCount / @coupon.MaxUses
                                    </td>
                                    <td style="padding: var(--space-3) var(--space-4); color: var(--color-text-muted); font-size: var(--fs-xs);">
                                        @coupon.ExpiryDate.ToString("MMM dd, yyyy HH:mm")
                                    </td>
                                    <td style="padding: var(--space-3) var(--space-4);">
                                        @if (isExpired)
                                        {
                                            <span style="padding: 2px 8px; border-radius: var(--radius-pill); font-size: var(--fs-xs); background: rgba(155, 59, 52, 0.1); color: var(--color-danger); font-weight: 600;">Expired</span>
                                        }
                                        else if (isMaxReached)
                                        {
                                            <span style="padding: 2px 8px; border-radius: var(--radius-pill); font-size: var(--fs-xs); background: rgba(168, 84, 46, 0.1); color: var(--color-clay); font-weight: 600;">Maxed Out</span>
                                        }
                                        else
                                        {
                                            <span style="padding: 2px 8px; border-radius: var(--radius-pill); font-size: var(--fs-xs); background: rgba(63, 122, 92, 0.1); color: var(--color-success, #2e7d32); font-weight: 600;">Active</span>
                                        }
                                    </td>
                                    <td style="padding: var(--space-3) var(--space-4); text-align: right;">
                                        <form asp-controller="Admin" asp-action="DeleteCoupon" asp-route-id="@coupon.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this coupon?');" style="margin: 0; display: inline-block;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" style="background: transparent; border: none; color: var(--color-danger); cursor: pointer; font-size: var(--fs-xs); font-weight: 600;">
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div style="padding: var(--space-8); text-align: center; color: var(--color-text-muted);">
                    <p style="margin: 0;">No coupons created yet. Use the form on the left to create your first coupon.</p>
                </div>
            }
        </div>
    </div>
</div>
