@model AdminUsersViewModel

<table style="width: 100%; border-collapse: collapse; text-align: left;">
    <thead style="background: var(--color-surface-sunk); font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted);">
        <tr>
            <th style="padding: var(--space-4); border-bottom: 1px solid var(--color-border);">@Localizer["User"]</th>
            <th style="padding: var(--space-4); border-bottom: 1px solid var(--color-border);">@Localizer["Email"]</th>
            <th style="padding: var(--space-4); border-bottom: 1px solid var(--color-border);">@Localizer["Role"]</th>
            <th style="padding: var(--space-4); border-bottom: 1px solid var(--color-border);">@Localizer["Status"]</th>
            <th style="padding: var(--space-4); border-bottom: 1px solid var(--color-border); text-align: right;">@Localizer["Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Users.Any())
        {
            <tr>
                <td colspan="5" style="padding: var(--space-4); text-align: center; color: var(--color-text-muted);">
                    @Localizer["NoUsersFound"]
                </td>
            </tr>
        }
        else
        {
            foreach (var user in Model.Users)
            {
                <tr style="border-bottom: 1px solid var(--color-border);">
                    <td style="padding: var(--space-4); font-size: var(--fs-sm); font-weight: 600;">@user.FullName</td>
                    <td style="padding: var(--space-4); font-size: var(--fs-sm); color: var(--color-text-muted);">@user.Email</td>
                    <td style="padding: var(--space-4); font-size: var(--fs-sm);">
                        @(user.IsHost ? Localizer["Host"] : Localizer["Guest"])
                    </td>
                    <td style="padding: var(--space-4); font-size: var(--fs-sm);">
                        @if (user.IsLockedOut)
                        {
                            <span style="color: var(--color-danger); font-weight: 600;">@Localizer["Suspended"]</span>
                        }
                        else
                        {
                            <span style="color: var(--color-success);">@Localizer["Active"]</span>
                        }
                    </td>
                    <td style="padding: var(--space-4); text-align: right;">
                        @if (user.IsLockedOut)
                        {
                            <form asp-action="UnlockUser" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="btn-primary" style="background: var(--color-surface); color: var(--color-navy); border: 1px solid var(--color-border-strong); padding: var(--space-1) var(--space-3); border-radius: var(--radius-sm); font-size: var(--fs-sm);">
                                    @Localizer["Unlock"]
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="LockUser" method="post" onsubmit="return confirm('@Localizer["ConfirmSuspendUser"]');" style="display:inline;">
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="btn-primary" style="background: rgba(155, 59, 52, 0.1); color: var(--color-danger); border: none; padding: var(--space-1) var(--space-3); border-radius: var(--radius-sm); font-size: var(--fs-sm);">
                                    @Localizer["Suspend"]
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>