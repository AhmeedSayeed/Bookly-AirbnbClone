@model AdminUsersViewModel

@{
    ViewData["Title"] = "Manage Users";
}

<div style="max-width: var(--content-max); margin: 0 auto; padding: var(--space-6) var(--gutter);">
    <h1 class="font-display" style="font-size: var(--fs-xl); margin-bottom: var(--space-6);">Manage Users</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="padding: var(--space-3); background: var(--color-surface-sunk); color: var(--color-success); border-radius: var(--radius-sm); margin-bottom: var(--space-4);">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div style="padding: var(--space-3); background: rgba(155, 59, 52, 0.1); color: var(--color-danger); border-radius: var(--radius-sm); margin-bottom: var(--space-4);">
            @TempData["ErrorMessage"]
        </div>
    }

    <div style="background: var(--color-surface); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); overflow: hidden; border: 1px solid var(--color-border);">
        <table style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead style="background: var(--color-surface-sunk); font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted);">
                <tr>
                    <th style="padding: var(--space-4); border-bottom: 1px solid var(--color-border);">User</th>
                    <th style="padding: var(--space-4); border-bottom: 1px solid var(--color-border);">Email</th>
                    <th style="padding: var(--space-4); border-bottom: 1px solid var(--color-border);">Role</th>
                    <th style="padding: var(--space-4); border-bottom: 1px solid var(--color-border);">Status</th>
                    <th style="padding: var(--space-4); border-bottom: 1px solid var(--color-border); text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr style="border-bottom: 1px solid var(--color-border);">
                        <td style="padding: var(--space-4); font-size: var(--fs-sm); font-weight: 600;">@user.FullName</td>
                        <td style="padding: var(--space-4); font-size: var(--fs-sm); color: var(--color-text-muted);">@user.Email</td>
                        <td style="padding: var(--space-4); font-size: var(--fs-sm);">
                            @(user.IsHost ? "Host" : "Guest")
                        </td>
                        <td style="padding: var(--space-4); font-size: var(--fs-sm);">
                            @if (user.IsLockedOut)
                            {
                                <span style="color: var(--color-danger); font-weight: 600;">Suspended</span>
                            }
                            else
                            {
                                <span style="color: var(--color-success);">Active</span>
                            }
                        </td>
                        <td style="padding: var(--space-4); text-align: right;">
                            @if (user.IsLockedOut)
                            {
                                <form asp-action="UnlockUser" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn-primary" style="background: var(--color-surface); color: var(--color-navy); border: 1px solid var(--color-border-strong); padding: var(--space-1) var(--space-3); border-radius: var(--radius-sm); font-size: var(--fs-sm);">Unlock</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="LockUser" method="post" onsubmit="return confirm('Are you sure you want to suspend this user? This will log them out immediately.');" style="display:inline;">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn-primary" style="background: rgba(155, 59, 52, 0.1); color: var(--color-danger); border: none; padding: var(--space-1) var(--space-3); border-radius: var(--radius-sm); font-size: var(--fs-sm);">Suspend</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>