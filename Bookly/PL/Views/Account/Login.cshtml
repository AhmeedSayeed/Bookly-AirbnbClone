@model BLL.ViewModels.Account.LoginViewModel
@{

    ViewData["Title"] = Localizer["Login"];
}

<div class="auth-container">
    <h1 class="font-display" style="font-size: var(--fs-xl); margin-bottom: var(--space-6); text-align: center;">
        @Localizer["WelcomeBack"]
    </h1>

    <form asp-controller="Account" asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly" class="form-error" style="margin-bottom: var(--space-4);"></div>

        <div class="form-group">
            <label asp-for="Email" class="form-label">
                @Localizer["Email"]
            </label>
            <input asp-for="Email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Email" class="form-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password" class="form-label">
                @Localizer["Password"]
            </label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="form-error"></span>
        </div>
        <div class="text-end mb-3">
            <a asp-action="ForgotPassword" asp-controller="Account">
                @Localizer["ForgotPassword"]
            </a>
        </div>
        @* <div class="form-group" style="display: flex; align-items: center; gap: var(--space-2);">
            <input asp-for="RememberMe" type="checkbox" style="accent-color: var(--color-navy); width: 18px; height: 18px;" />
            <label asp-for="RememberMe" style="font-size: var(--fs-sm); color: var(--color-text); margin: 0; cursor: pointer;">Remember me?</label>
        </div> *@

        <button type="submit" class="btn-primary" style="width: 100%; margin-top: var(--space-2);">
            @Localizer["Login"]
        </button>
    </form>

    <div class="auth-footer">
        @Localizer["DontHaveAccount"]
        <a asp-controller="Account" asp-action="Register">
            @Localizer["SignUp"]
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}