@{
    ViewData["Title"] = Localizer["CheckYourEmail"];
}

<div class="container mt-5">
    <div class="text-center mx-auto" style="max-width: 600px;">

        <div class="mb-4">
            <span style="font-size: 60px;">📧</span>
        </div>

        <h2>@Localizer["CheckYourEmail"]</h2>

        <p class="mt-3">
            @Localizer["AccountCreatedSuccessfully"]
        </p>

        <p class="text-muted">
            @Localizer["VerificationLinkSent"]
            @Localizer["CheckInboxVerifyAccount"]
        </p>

        <p class="text-muted small">
            @Localizer["DidntReceiveEmail"]
            @Localizer["CheckSpamFolder"]
        </p>

    </div>
</div>