@model BLL.DTOs.Auth.ResetPasswordDto

@{
    ViewData["Title"] = Localizer["ResetPassword"];
}

<div class="auth-container">

    <div class="text-center mb-4">
        <div style="
            width: 64px;
            height: 64px;
            margin: 0 auto var(--space-4);
            border-radius: 50%;
            background: #eef2fa;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;">
            🔐
        </div>

        <h1 class="font-display"
            style="
            font-size: var(--fs-xl);
            margin-bottom: var(--space-2);
            ">
            @Localizer["ResetPassword"]
        </h1>

        <p style="
            color: var(--color-text-muted);
            margin: 0;
            font-size: var(--fs-sm);
            ">
            @Localizer["EnterNewPassword"]
        </p>
    </div>


    <form asp-action="ResetPassword" method="post">

        <div asp-validation-summary="ModelOnly"
             class="form-error"
             style="margin-bottom: var(--space-4);">
        </div>


        <input asp-for="UserId" type="hidden" />
        <input asp-for="Token" type="hidden" />


        <div class="form-group">

            <label asp-for="NewPassword" class="form-label">
                @Localizer["NewPassword"]
            </label>

            <input asp-for="NewPassword"
                   type="password"
                   class="form-control"
                   placeholder="@Localizer["EnterNewPasswordPlaceholder"]"
                   autocomplete="new-password" />

            <span asp-validation-for="NewPassword"
                  class="form-error">
            </span>

        </div>


        <div class="form-group">

            <label asp-for="ConfirmPassword" class="form-label">
                @Localizer["ConfirmPassword"]
            </label>

            <input asp-for="ConfirmPassword"
                   type="password"
                   class="form-control"
                   placeholder="@Localizer["ConfirmNewPasswordPlaceholder"]"
                   autocomplete="new-password" />

            <span asp-validation-for="ConfirmPassword"
                  class="form-error">
            </span>

        </div>


        <button type="submit"
                class="btn-primary"
                style="
            width: 100%;
            margin-top: var(--space-2);
            ">
            @Localizer["ResetPassword"]
        </button>

    </form>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}