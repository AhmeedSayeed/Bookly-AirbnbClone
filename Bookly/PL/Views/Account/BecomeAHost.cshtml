@model BecomeAHostViewModel

@{
    ViewData["Title"] = "Become a Host";
    var currentStatus = ViewBag.VerificationStatus as string;
}

<div style="max-width: 600px; margin: 0 auto; padding: var(--space-8) var(--gutter);">
    <h1 class="font-display" style="font-size: var(--fs-xl); margin-bottom: var(--space-4);">Become a Host</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="padding: var(--space-4); background: var(--color-surface-sunk); color: var(--color-success); border-radius: var(--radius-sm); margin-bottom: var(--space-5);">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div style="padding: var(--space-4); background: var(--color-surface-sunk); color: var(--color-navy); border-radius: var(--radius-sm); margin-bottom: var(--space-5); border: 1px solid var(--color-border-strong);">
            @TempData["InfoMessage"]
        </div>
    }

    @if (currentStatus == "Pending")
    {
        <!-- Pending State -->
        <div style="padding: var(--space-6); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); text-align: center;">
            <h2 class="font-display" style="font-size: var(--fs-lg); margin-bottom: var(--space-2);">Application Under Review</h2>
            <p style="color: var(--color-text-muted); margin-bottom: 0;">Our team is currently reviewing your ID document. We will notify you once your account has been upgraded to a Host profile.</p>
        </div>
    }
    else
    {
        <!-- Form State (New or Rejected) -->
        <p style="font-size: var(--fs-base); color: var(--color-text-muted); margin-bottom: var(--space-6);">To ensure the safety of our community, we require a valid government-issued ID before you can list a property.</p>

        @if (currentStatus == "Rejected")
        {
            <div style="padding: var(--space-3); background: rgba(155, 59, 52, 0.1); color: var(--color-danger); border-radius: var(--radius-sm); margin-bottom: var(--space-5);">
                Your previous application was rejected. Please ensure your ID is clear, readable, and valid before applying again.
            </div>
        }

        <form asp-action="BecomeAHost" method="post" enctype="multipart/form-data" style="background: var(--color-surface); border: 1px solid var(--color-border); padding: var(--space-5); border-radius: var(--radius-md); box-shadow: var(--shadow-sm);">
            <div asp-validation-summary="ModelOnly" style="color: var(--color-danger); margin-bottom: var(--space-4);"></div>

            <div class="form-group" style="margin-bottom: var(--space-6);">
                <label style="font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted); display: block; margin-bottom: var(--space-2);">Government ID</label>

                <!-- Custom File Upload Container -->
                <div style="position: relative; border: 2px dashed var(--color-border-strong); border-radius: var(--radius-md); padding: var(--space-6); text-align: center; transition: border-color var(--duration-fast); background: var(--color-surface-sunk); overflow: hidden;">

                    <!-- The invisible file input overlaying the container -->
                    <input type="file" asp-for="IdDocument" id="id-upload" accept="image/*,.pdf" style="position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; z-index: 2;" onchange="handleFilePreview(event)" />

                    <!-- Placeholder UI (Visible initially) -->
                    <div id="upload-placeholder" style="pointer-events: none;">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-navy)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: var(--space-3);">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            <circle cx="8.5" cy="8.5" r="1.5"></circle>
                            <polyline points="21 15 16 10 5 21"></polyline>
                        </svg>
                        <p style="margin: 0; font-weight: 600; color: var(--color-navy); font-size: var(--fs-md);">Upload your ID</p>
                        <p style="margin: var(--space-1) 0 0 0; font-size: var(--fs-xs); color: var(--color-text-muted);">Click or drag to select</p>
                    </div>

                    <!-- Image Preview (Hidden initially) -->
                    <img id="image-preview" src="" alt="ID Preview" style="display: none; max-width: 100%; max-height: 250px; margin: 0 auto; border-radius: var(--radius-sm); position: relative; z-index: 1;" />

                    <!-- PDF/File Name Preview (Hidden initially) -->
                    <div id="file-name-preview" style="display: none; position: relative; z-index: 1;">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--color-brass)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: var(--space-2);">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                        </svg>
                        <p id="file-name-text" style="margin: 0; font-weight: 600; color: var(--color-navy); font-size: var(--fs-sm); word-break: break-all;"></p>
                        <p style="margin: var(--space-1) 0 0 0; font-size: var(--fs-xs); color: var(--color-text-muted);">Click to change file</p>
                    </div>
                </div>

                <span asp-validation-for="IdDocument" style="color: var(--color-danger); font-size: var(--fs-sm); display: block; margin-top: var(--space-2);"></span>
                <p style="font-size: var(--fs-xs); color: var(--color-text-muted); margin-top: var(--space-2);">Accepted formats: JPG, PNG, PDF.</p>
            </div>

            <button type="submit" class="btn-primary" style="width: 100%; padding: var(--space-4); border-radius: var(--radius-pill); background: var(--color-navy); color: var(--color-surface);">Submit for Verification</button>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function handleFilePreview(event) {
            const file = event.target.files[0];
            const placeholder = document.getElementById('upload-placeholder');
            const imagePreview = document.getElementById('image-preview');
            const filePreview = document.getElementById('file-name-preview');
            const fileNameText = document.getElementById('file-name-text');

            // Reset UI states
            placeholder.style.display = 'none';
            imagePreview.style.display = 'none';
            filePreview.style.display = 'none';

            if (file) {
                // If the file is an image, use FileReader to generate a preview
                if (file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        imagePreview.src = e.target.result;
                        imagePreview.style.display = 'block';
                    }
                    reader.readAsDataURL(file);
                }
                // If it's a PDF, display the icon and file name
                else {
                    fileNameText.textContent = file.name;
                    filePreview.style.display = 'block';
                }
            } else {
                // Restore placeholder if the user cancels file selection
                placeholder.style.display = 'block';
            }
        }
    </script>
}