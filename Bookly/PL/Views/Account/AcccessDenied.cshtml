@{
    ViewData["Title"] = "Access Denied";
}

<div style="max-width: 500px; margin: 10vh auto; text-align: center; padding: var(--space-8) var(--space-6); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-md);">

    <!-- Security / Lock Icon -->
    <div style="display: inline-flex; align-items: center; justify-content: center; width: 80px; height: 80px; border-radius: 50%; background: rgba(155, 59, 52, 0.1); color: var(--color-danger); margin-bottom: var(--space-5);">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
    </div>

    <h1 class="font-display" style="font-size: var(--fs-xl); color: var(--color-navy); margin-bottom: var(--space-3);">
        Access Denied
    </h1>

    <p style="font-size: var(--fs-base); color: var(--color-text-muted); margin-bottom: var(--space-6); line-height: 1.6;">
        You do not have the required permissions to view this page or perform this action. This usually happens if you are trying to access a Host feature with a standard Guest account.
    </p>

    <div style="display: flex; gap: var(--space-3); justify-content: center; flex-wrap: wrap;">

        <a href="javascript:history.back()" style="padding: var(--space-3) var(--space-6); border-radius: var(--radius-pill); background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-text); text-decoration: none; font-weight: 600; cursor: pointer;">
            Go Back
        </a>

        <a asp-controller="Home" asp-action="Index" class="btn-primary" style="padding: var(--space-3) var(--space-6); border-radius: var(--radius-pill); background: var(--color-navy); color: var(--color-surface); text-decoration: none; font-weight: 600;">
            Return to Home
        </a>

    </div>
</div>