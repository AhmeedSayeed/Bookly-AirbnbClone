@model HomeViewModel

@{
    ViewData["Title"] = Localizer["DiscoverPlacesToStay"];
    var isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
}

@if (isAuthenticated)
{
    @Html.AntiForgeryToken()
}

<!-- The Hero Search Pill -->
<form asp-controller="Listings" asp-action="Index" method="get" class="search-pill" style="max-width: 700px; margin: 0 auto; display: flex; align-items: center;">

    <!-- Omnibox Segment -->
    <div class="search-pill__segment" style="flex-grow: 1; border-right: none; width: 100%;">
        <label for="searchTerm" style="font-weight: 600; color: var(--color-navy);">
            @Localizer["WhatAreYouLookingFor"]
        </label>
        <input type="text"
               id="searchTerm"
               name="SearchTerm"
               placeholder="@Localizer["SearchPlaceholderExpressive"]"
               autocomplete="off"
               style="width: 100%; font-size: var(--fs-md); outline: none; border: none; background: transparent; margin-top: var(--space-1);" />
    </div>

    <button type="submit"
            class="search-pill__btn"
            aria-label="@Localizer["Search"]">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
    </button>
</form>

<h1 class="font-display"
    style="font-size: var(--fs-xl); margin-top: var(--space-8);">
    @Localizer["FeaturedStays"]
</h1>

<!-- Listings Grid -->
<div class="listings-grid">

    @if (Model.FeaturedListings != null && Model.FeaturedListings.Any())
    {
        foreach (var listing in Model.FeaturedListings)
        {
            <a href="/Listings/Details/@listing.Id" class="listing-card">

                <div class="listing-card__image-wrapper" style="position: relative;">
                    <img src="@(string.IsNullOrEmpty(listing.PrimaryPhotoUrl)
                                                                                          ? "/images/placeholder.jpg"
                                                                                          : listing.PrimaryPhotoUrl)"
                         alt="@listing.Title"
                         class="listing-card__image" />

                    @if (isAuthenticated)
                    {
                        <button type="button"
                                class="wishlist-toggle-btn"
                                data-listing-id="@listing.Id"
                                title="@Localizer["Wishlist"]"
                                onclick="event.preventDefault(); event.stopPropagation();"
                                style="position: absolute; top: var(--space-2); right: var(--space-2);
                            width: 60px; height: 60px; border-radius: var(--radius-pill);
                            border: none; background: rgba(255,255,255,0.85);
                            display: flex; align-items: center; justify-content: center;
                            cursor: pointer; z-index: 2;">
                            <span class="wishlist-heart-icon"
                                  style="color: @(listing.IsWishlisted ? "#8B1E1E" : "var(--color-clay)"); font-size: 38px; line-height: 1;">&#9829;</span>
                        </button>
                    }
                </div>

                <div class="listing-card__body">

                    <h3 class="listing-card__title">
                        @listing.Title
                    </h3>

                    <div class="listing-card__location">
                        @listing.City, @listing.Country
                    </div>

                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: var(--space-3);">

                        <div class="listing-card__price">
                            $@listing.PricePerNight.ToString("0")
                            <span style="font-size: var(--fs-sm); font-weight: 400; color: var(--color-text-muted);">
                                @Localizer["PerNight"]
                            </span>
                        </div>

                        @if (listing.AverageRating > 0)
                        {
                            <div style="font-weight: 600; display: flex; align-items: center; gap: var(--space-1);">
                                <span style="color: var(--color-brass);">★</span>
                                @listing.AverageRating.ToString("0.0")
                            </div>
                        }

                    </div>

                </div>
            </a>
        }
    }
    else
    {
        <div style="grid-column: 1 / -1; text-align: center; padding: var(--space-8) 0; color: var(--color-text-muted);">
            <p>@Localizer["NoListingsFound"]</p>
        </div>
    }

</div>

@if (isAuthenticated)
{
    <!-- Wishlist Toggle Logic -->
    <script>
        document.querySelectorAll('.wishlist-toggle-btn').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();

                var listingId = btn.getAttribute('data-listing-id');
                var icon = btn.querySelector('.wishlist-heart-icon');

                fetch('@Url.Action("Toggle", "Wishlist")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: 'listingId=' + encodeURIComponent(listingId)
                })
                    .then(function(res) { return res.json(); })
                    .then(function(data) {
                        if (data.success) {
                            icon.style.color = data.isWishlisted ? '#8B1E1E' : 'var(--color-clay)';
                        }
                    });
            });
        });
    </script>
}