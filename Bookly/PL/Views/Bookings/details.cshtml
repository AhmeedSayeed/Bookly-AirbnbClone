@model BLL.ViewModels.Bookings.BookingDetailsViewModel

@{
    ViewData["Title"] = "Booking Details";

    // Helper method to extract 1 or 2 uppercase initials from a full name
    string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "U";

        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();

        return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }
}

<div style="max-width: 800px; margin: 0 auto; padding: var(--space-6) var(--gutter);">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-6); flex-wrap: wrap; gap: var(--space-4);">
        <div>
            <h1 class="font-display" style="font-size: var(--fs-xl); margin: 0 0 var(--space-1) 0;">Reservation Details</h1>
            <p style="color: var(--color-text-muted); margin: 0;">Booking ID: #@Model.Id</p>
        </div>
        <span style="padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill); background: var(--color-surface-sunk); font-weight: 600; font-size: var(--fs-sm); border: 1px solid var(--color-border);">
            @Model.Status
        </span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="padding: var(--space-3); background: var(--color-surface-sunk); color: var(--color-success, #2e7d32); border-radius: var(--radius-sm); margin-bottom: var(--space-4);">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div style="padding: var(--space-3); background: rgba(155, 59, 52, 0.1); color: var(--color-danger); border-radius: var(--radius-sm); margin-bottom: var(--space-4);">
            @TempData["ErrorMessage"]
        </div>
    }

    <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-6); align-items: start;">

        <!-- Left Column: Listing & Dates -->
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-5); box-shadow: var(--shadow-sm);">

            <div style="position: relative; padding-top: 56.25%; border-radius: var(--radius-sm); overflow: hidden; margin-bottom: var(--space-4); background: var(--color-surface-sunk);">
                <img src="@(string.IsNullOrEmpty(Model.ListingPhotoUrl) ? "/images/placeholder.jpg" : Model.ListingPhotoUrl)"
                     style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" />
            </div>

            <h2 class="font-display" style="font-size: var(--fs-lg); margin: 0 0 var(--space-1) 0;">@Model.ListingTitle</h2>
            <p style="color: var(--color-text-muted); font-size: var(--fs-sm); margin: 0 0 var(--space-4) 0;">@Model.ListingAddress</p>

            <hr style="border: none; border-top: 1px solid var(--color-border); margin-bottom: var(--space-4);" />

            <div style="display: flex; justify-content: space-between; margin-bottom: var(--space-3); font-size: var(--fs-sm);">
                <span style="color: var(--color-text-muted);">Check-in Date:</span>
                <strong>@Model.CheckInDate.ToString("MMMM dd, yyyy")</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: var(--space-3); font-size: var(--fs-sm);">
                <span style="color: var(--color-text-muted);">Checkout Date:</span>
                <strong>@Model.CheckOutDate.ToString("MMMM dd, yyyy")</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: var(--space-4); font-size: var(--fs-sm);">
                <span style="color: var(--color-text-muted);">Guests:</span>
                <strong>@Model.NumberOfGuests Guests</strong>
            </div>

            <hr style="border: none; border-top: 1px solid var(--color-border); margin-bottom: var(--space-4);" />

            <div style="display: flex; justify-content: space-between; font-size: var(--fs-md); font-weight: 700; color: var(--color-navy);">
                <span>Total Amount:</span>
                <span>@Model.TotalPrice.ToString("C")</span>
            </div>
        </div>

        <!-- Right Column: People & Actions -->
        <div style="display: flex; flex-direction: column; gap: var(--space-5);">

            <!-- Guest Card -->
            <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4); box-shadow: var(--shadow-sm);">
                <h3 class="font-display" style="font-size: 11px; margin-bottom: var(--space-3); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.05em;">Guest Details</h3>
                <div style="display: flex; align-items: center; gap: var(--space-3);">
                    @if (!string.IsNullOrWhiteSpace(Model.Guest?.ProfilePhotoUrl))
                    {
                        <img src="@Model.Guest.ProfilePhotoUrl"
                             alt="@Model.Guest.FullName"
                             style="width: 44px; height: 44px; border-radius: 50%; object-fit: cover;"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div style="display: none; width: 44px; height: 44px; border-radius: 50%; background: #ede3d4; color: #6a4e32; align-items: center; justify-content: center; font-weight: 700; font-size: var(--fs-sm); flex-shrink: 0;">
                            @GetInitials(Model.Guest?.FullName)
                        </div>
                    }
                    else
                    {
                        <div style="width: 44px; height: 44px; border-radius: 50%; background: #ede3d4; color: #6a4e32; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: var(--fs-sm); flex-shrink: 0;">
                            @GetInitials(Model.Guest?.FullName)
                        </div>
                    }
                    <div>
                        <h4 class="font-display" style="font-size: var(--fs-sm); margin: 0 0 2px 0;">@Model.Guest?.FullName</h4>
                        <p style="font-size: var(--fs-xs); color: var(--color-text-muted); margin: 0;">Verified Guest</p>
                    </div>
                </div>
            </div>

            <!-- Host Card -->
            <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4); box-shadow: var(--shadow-sm);">
                <h3 class="font-display" style="font-size: 11px; margin-bottom: var(--space-3); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.05em;">Host Details</h3>
                <div style="display: flex; align-items: center; gap: var(--space-3);">
                    @if (!string.IsNullOrWhiteSpace(Model.Host?.ProfilePhotoUrl))
                    {
                        <img src="@Model.Host.ProfilePhotoUrl"
                             alt="@Model.Host.FullName"
                             style="width: 44px; height: 44px; border-radius: 50%; object-fit: cover;"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div style="display: none; width: 44px; height: 44px; border-radius: 50%; background: #ede3d4; color: #6a4e32; align-items: center; justify-content: center; font-weight: 700; font-size: var(--fs-sm); flex-shrink: 0;">
                            @GetInitials(Model.Host?.FullName)
                        </div>
                    }
                    else
                    {
                        <div style="width: 44px; height: 44px; border-radius: 50%; background: #ede3d4; color: #6a4e32; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: var(--fs-sm); flex-shrink: 0;">
                            @GetInitials(Model.Host?.FullName)
                        </div>
                    }
                    <div>
                        <h4 class="font-display" style="font-size: var(--fs-sm); margin: 0 0 2px 0;">@Model.Host?.FullName</h4>
                        <p style="font-size: var(--fs-xs); color: var(--color-text-muted); margin: 0;">Property Host</p>
                    </div>
                </div>
            </div>

            <!-- Coupon Box & Action Buttons -->
            <div style="display: flex; flex-direction: column; gap: var(--space-4);">

                <!-- Coupon Input Box (Only for Confirmed/Pending bookings) -->
                @if (Model.Status == "Confirmed" || Model.Status == "Pending")
                {
                    <div style="background: var(--color-surface); border: 1px dashed var(--color-border-strong); border-radius: var(--radius-md); padding: var(--space-4);">
                        <label style="font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; color: var(--color-text-muted); display: block; margin-bottom: var(--space-2);">
                            Have a coupon code?
                        </label>
                        <div style="display: flex; gap: var(--space-2);">
                            <input type="text" id="couponCodeInput" placeholder="e.g. SUMMER20" class="form-control" style="text-transform: uppercase; font-family: var(--font-mono); font-weight: 600;" />
                            <button type="button" id="btnApplyCoupon" onclick="applyCoupon()" class="btn-primary" style="padding: var(--space-2) var(--space-4); font-size: var(--fs-sm); white-space: nowrap;">
                                Apply
                            </button>
                        </div>
                        <div id="couponMessage" style="font-size: var(--fs-xs); margin-top: var(--space-2); display: none;"></div>
                    </div>
                }

                <!-- Pay Now Button -->
                @if (Model.Status == "Confirmed")
                {
                    <form asp-controller="Payments" asp-action="Checkout" method="post" style="margin: 0;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookingId" value="@Model.Id" />
                        <input type="hidden" name="method" value="1" />
                        <button type="submit"
                                id="btnPayNow"
                                class="btn-primary"
                                style="width: 100%; padding: var(--space-3); border-radius: var(--radius-pill); background: var(--color-navy); color: var(--color-surface); font-weight: 600; cursor: pointer; font-size: var(--fs-md); border: none;">
                            Pay Now (<span id="payAmountDisplay">@Model.TotalPrice.ToString("C")</span>)
                        </button>
                    </form>
                }

                <!-- Cancel Button -->
                @if (Model.Status != "Cancelled" && Model.Status != "Completed" && Model.Status != "Rejected" && Model.Status != "Paid")
                {
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel this booking?');" style="margin: 0;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                        <button type="submit" style="width: 100%; padding: var(--space-3); border-radius: var(--radius-pill); background: transparent; border: 1px solid var(--color-danger); color: var(--color-danger); font-weight: 600; cursor: pointer; font-size: var(--fs-sm);">
                            Cancel Reservation
                        </button>
                    </form>
                }
            </div>

            @section Scripts {
                <script>
                                function applyCoupon() {
                                    const codeInput = document.getElementById('couponCodeInput');
                                    const messageDiv = document.getElementById('couponMessage');
                                    const btnApply = document.getElementById('btnApplyCoupon');
                                    const code = codeInput.value.trim();

                                    if (!code) return;

                                    btnApply.disabled = true;
                                    btnApply.innerText = 'Applying...';

                                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

                                    fetch('/Coupons/Apply', {
                                        method: 'POST',
                                        headers: {
                                            'Content-Type': 'application/x-www-form-urlencoded',
                                            'RequestVerificationToken': token
                                        },
                                        body: `bookingId=@Model.Id&code=${encodeURIComponent(code)}`
                                    })
                                        .then(res => res.json())
                                        .then(data => {
                                            btnApply.disabled = false;
                                            btnApply.innerText = 'Apply';
                                            messageDiv.style.display = 'block';

                                            if (data.success) {
                                                messageDiv.style.color = 'var(--color-success, #2e7d32)';
                                                messageDiv.innerHTML = `<strong>${data.message}</strong> - Saved $${data.discountAmount.toFixed(2)}`;
                                                codeInput.disabled = true;
                                                btnApply.style.display = 'none';

                                                // Update price display on the screen
                                                const payAmountSpan = document.getElementById('payAmountDisplay');
                                                if (payAmountSpan) {
                                                    payAmountSpan.innerText = `$${data.newTotalPrice.toFixed(2)}`;
                                                }
                                            } else {
                                                messageDiv.style.color = 'var(--color-danger)';
                                                messageDiv.innerText = data.message;
                                            }
                                        })
                                        .catch(err => {
                                            btnApply.disabled = false;
                                            btnApply.innerText = 'Apply';
                                            messageDiv.style.display = 'block';
                                            messageDiv.style.color = 'var(--color-danger)';
                                            messageDiv.innerText = 'Failed to apply coupon. Please try again.';
                                        });
                                }
                </script>
            }

            <div style="text-align: center; margin-top: var(--space-2);">
                <a asp-action="MyTrips" style="font-size: var(--fs-sm); color: var(--color-text-muted); text-decoration: none;">&larr; Back to My Trips</a>
            </div>

        </div>

    </div>
</div>