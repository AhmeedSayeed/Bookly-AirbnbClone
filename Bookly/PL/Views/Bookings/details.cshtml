@model BLL.ViewModels.Bookings.BookingDetailsViewModel

@{
    ViewData["Title"] = "Booking Details";
}

<div style="max-width: 800px; margin: 0 auto; padding: var(--space-6) var(--gutter);">
    
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-6); flex-wrap: wrap; gap: var(--space-4);">
        <div>
            <h1 class="font-display" style="font-size: var(--fs-xl); margin: 0 0 var(--space-1) 0;">Reservation Details</h1>
            <p style="color: var(--color-text-muted); margin: 0;">Booking ID: #@Model.Id</p>
        </div>
        <span style="padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill); background: var(--color-surface-sunk); font-weight: 600; font-size: var(--fs-sm); border: 1px solid var(--color-border);">
            @Model.Status
        </span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="padding: var(--space-3); background: var(--color-surface-sunk); color: var(--color-success); border-radius: var(--radius-sm); margin-bottom: var(--space-4);">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div style="padding: var(--space-3); background: rgba(155, 59, 52, 0.1); color: var(--color-danger); border-radius: var(--radius-sm); margin-bottom: var(--space-4);">
            @TempData["ErrorMessage"]
        </div>
    }

    <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-6); align-items: start;">
        
        <!-- Left Column: Listing & Dates -->
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-5); box-shadow: var(--shadow-sm);">
            
            <div style="position: relative; padding-top: 56.25%; border-radius: var(--radius-sm); overflow: hidden; margin-bottom: var(--space-4); background: var(--color-surface-sunk);">
                <img src="@(string.IsNullOrEmpty(Model.ListingPhotoUrl) ? "/images/placeholder.jpg" : Model.ListingPhotoUrl)" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" />
            </div>

            <h2 class="font-display" style="font-size: var(--fs-lg); margin: 0 0 var(--space-1) 0;">@Model.ListingTitle</h2>
            <p style="color: var(--color-text-muted); font-size: var(--fs-sm); margin: 0 0 var(--space-4) 0;">@Model.ListingAddress</p>

            <hr style="border: none; border-top: 1px solid var(--color-border); margin-bottom: var(--space-4);" />

            <div style="display: flex; justify-content: space-between; margin-bottom: var(--space-3); font-size: var(--fs-sm);">
                <span style="color: var(--color-text-muted);">Check-in Date:</span>
                <strong>@Model.CheckInDate.ToString("MMMM dd, yyyy")</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: var(--space-3); font-size: var(--fs-sm);">
                <span style="color: var(--color-text-muted);">Checkout Date:</span>
                <strong>@Model.CheckOutDate.ToString("MMMM dd, yyyy")</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: var(--space-4); font-size: var(--fs-sm);">
                <span style="color: var(--color-text-muted);">Guests:</span>
                <strong>@Model.NumberOfGuests Guests</strong>
            </div>

            <hr style="border: none; border-top: 1px solid var(--color-border); margin-bottom: var(--space-4);" />

            <div style="display: flex; justify-content: space-between; font-size: var(--fs-md); font-weight: 700; color: var(--color-navy);">
                <span>Total Amount:</span>
                <span>@Model.TotalPrice.ToString("C")</span>
            </div>
        </div>

        <!-- Right Column: People & Actions -->
        <div style="display: flex; flex-direction: column; gap: var(--space-5);">
            
            <!-- Guest Card -->
            <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4); box-shadow: var(--shadow-sm);">
                <h3 class="font-display" style="font-size: var(--fs-md); margin-bottom: var(--space-3); color: var(--color-text-muted); text-transform: uppercase; font-size: 11px; letter-spacing: 0.05em;">Guest Details</h3>
                <div style="display: flex; align-items: center; gap: var(--space-3);">
                    <img src="@(string.IsNullOrEmpty(Model.Guest.ProfilePhotoUrl) ? "/images/avatar-placeholder.jpg" : Model.Guest.ProfilePhotoUrl)" style="width: 44px; height: 44px; border-radius: 50%; object-fit: cover;" />
                    <div>
                        <h4 class="font-display" style="font-size: var(--fs-sm); margin: 0 0 2px 0;">@Model.Guest.FullName</h4>
                        <p style="font-size: var(--fs-xs); color: var(--color-text-muted); margin: 0;">Verified Guest</p>
                    </div>
                </div>
            </div>

            <!-- Host Card -->
            <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4); box-shadow: var(--shadow-sm);">
                <h3 class="font-display" style="font-size: var(--fs-md); margin-bottom: var(--space-3); color: var(--color-text-muted); text-transform: uppercase; font-size: 11px; letter-spacing: 0.05em;">Host Details</h3>
                <div style="display: flex; align-items: center; gap: var(--space-3);">
                    <img src="@(string.IsNullOrEmpty(Model.Host.ProfilePhotoUrl) ? "/images/avatar-placeholder.jpg" : Model.Host.ProfilePhotoUrl)" style="width: 44px; height: 44px; border-radius: 50%; object-fit: cover;" />
                    <div>
                        <h4 class="font-display" style="font-size: var(--fs-sm); margin: 0 0 2px 0;">@Model.Host.FullName</h4>
                        <p style="font-size: var(--fs-xs); color: var(--color-text-muted); margin: 0;">Property Host</p>
                    </div>
                </div>
            </div>

            <!-- Cancellation Option -->
            @if (Model.Status != "Cancelled" && Model.Status != "Completed" && Model.Status != "Rejected")
            {
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <button type="submit" style="width: 100%; padding: var(--space-3); border-radius: var(--radius-pill); background: transparent; border: 1px solid var(--color-danger); color: var(--color-danger); font-weight: 600; cursor: pointer; font-size: var(--fs-sm);">
                        Cancel Reservation
                    </button>
                </form>
            }

            <div style="text-align: center; margin-top: var(--space-2);">
                <a href="javascript:history.back()" style="font-size: var(--fs-sm); color: var(--color-text-muted); text-decoration: none;">&larr; Back to previous page</a>
            </div>

        </div>

    </div>
</div>