@model List<BLL.ViewModels.Chat.ConversationViewModel>

@{
    ViewData["Title"] = Localizer["Messages"];
    var currentUserId = ViewBag.CurrentUserId != null ? (int)ViewBag.CurrentUserId : 0;
    var activeConversationId = ViewBag.ActiveConversationId != null ? (int)ViewBag.ActiveConversationId : 0;
}

<style>
    .inbox-container {
        display: grid;
        grid-template-columns: 320px 1fr;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        height: calc(100vh - 160px);
        min-height: 500px;
        overflow: hidden; /* يمنع الحاوية الأساسية من التمدد */
        box-shadow: var(--shadow-sm);
        margin-top: var(--space-4);
    }

    /* Sidebar Styles */
    .inbox-sidebar {
        border-right: 1px solid var(--color-border);
        display: flex;
        flex-direction: column;
        background: var(--color-surface);
        height: 100%;
        overflow: hidden;
    }

    .inbox-header {
        padding: var(--space-4);
        border-bottom: 1px solid var(--color-border);
        font-weight: 700;
        font-size: var(--fs-md);
        font-family: var(--font-display);
        flex-shrink: 0; /* يمنع الهيدر من الانضغاط */
    }

    .conversation-list {
        flex: 1; /* يأخذ المساحة المتبقية فقط */
        overflow-y: auto; /* يسمح بعمل سكرول هنا فقط */
    }

    .conversation-item {
        display: flex;
        gap: var(--space-3);
        padding: var(--space-3) var(--space-4);
        cursor: pointer;
        border-bottom: 1px solid var(--color-border);
        transition: background 0.2s ease;
    }

        .conversation-item:hover {
            background: var(--color-surface-sunk);
        }

        .conversation-item.active {
            background: rgba(43, 58, 85, 0.05);
            border-left: 4px solid var(--color-navy);
        }

    .conversation-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: cover;
    }

    .conversation-info {
        flex-grow: 1;
        overflow: hidden;
    }

    .conversation-name {
        font-weight: 600;
        font-size: var(--fs-sm);
        margin-bottom: 2px;
        display: flex;
        justify-content: space-between;
    }

    .conversation-listing {
        font-size: 11px;
        color: var(--color-navy);
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .conversation-snippet {
        font-size: 12px;
        color: var(--color-text-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .unread-badge {
        background: var(--color-danger);
        color: white;
        font-size: 10px;
        padding: 2px 6px;
        border-radius: var(--radius-pill);
        font-weight: bold;
    }

    /* Main Chat Area Styles */
    .chat-area {
        display: flex;
        flex-direction: column;
        background: #fcfcfc;
        height: 100%;
        overflow: hidden; /* هام جداً للحفاظ على الأبعاد */
    }

    .chat-header {
        padding: var(--space-3) var(--space-4);
        border-bottom: 1px solid var(--color-border);
        background: var(--color-surface);
        display: flex;
        align-items: center;
        gap: var(--space-3);
        height: 73px;
        flex-shrink: 0; /* يمنع الهيدر من الانضغاط */
    }

    .chat-messages {
        flex: 1; /* يأخذ المساحة المتبقية بالكامل */
        padding: var(--space-4);
        overflow-y: auto; /* يجعل السكرول هنا فقط داخل الرسائل */
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .chat-input-area {
        padding: var(--space-3) var(--space-4);
        background: var(--color-surface);
        border-top: 1px solid var(--color-border);
        display: flex;
        gap: var(--space-2);
        flex-shrink: 0; /* هام جداً: يمنع حقل الإدخال من الاختفاء للأسفل */
    }

    .chat-input {
        flex-grow: 1;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-pill);
        padding: var(--space-2) var(--space-4);
        outline: none;
        font-family: var(--font-body);
    }

        .chat-input:focus {
            border-color: var(--color-navy);
        }

    .send-btn {
        background: var(--color-navy);
        color: white;
        border: none;
        border-radius: 50%;
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.2s ease;
    }

        .send-btn:hover {
            transform: scale(1.05);
        }

    /* Message Bubbles */
    .message-bubble {
        max-width: 70%;
        padding: var(--space-2) var(--space-3);
        border-radius: var(--radius-lg);
        font-size: var(--fs-sm);
        line-height: 1.4;
        position: relative;
    }

    .message-sent {
        align-self: flex-end;
        background: var(--color-navy);
        color: white;
        border-bottom-right-radius: 4px;
    }

    .message-received {
        align-self: flex-start;
        background: #e9ecef;
        color: var(--color-text);
        border-bottom-left-radius: 4px;
    }

    .message-time {
        font-size: 10px;
        opacity: 0.7;
        margin-top: 4px;
        text-align: right;
    }
</style>

<div class="inbox-container">

    <!-- Sidebar: Conversation List -->
    <div class="inbox-sidebar">
        <div class="inbox-header">
            @Localizer["Messages"]
        </div>

        <div class="conversation-list">
            @if (Model != null && Model.Any())
            {
                foreach (var conv in Model)
                {
                    <div class="conversation-item @(conv.Id == activeConversationId ? "active" : "")"
                         data-id="@conv.Id"
                         data-other-id="@conv.OtherUserId"
                         data-other-name="@conv.OtherUserName"
                         data-listing-title="@conv.ListingTitle"
                         onclick="loadConversation(@conv.Id, this)">

                        <img src="@(string.IsNullOrEmpty(conv.OtherUserPhotoUrl) ? "/images/default-avatar.png" : conv.OtherUserPhotoUrl)"
                             class="conversation-avatar" alt="@Localizer["Avatar"]" />

                        <div class="conversation-info">
                            <div class="conversation-name">
                                @conv.OtherUserName
                                @if (conv.UnreadCount > 0)
                                {
                                    <span class="unread-badge" id="badge-@conv.Id">@conv.UnreadCount</span>
                                }
                            </div>
                            <div class="conversation-listing">@conv.ListingTitle</div>
                            <div class="conversation-snippet" id="snippet-@conv.Id">
                                @conv.LastMessageContent
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="padding: var(--space-4); text-align: center; color: var(--color-text-muted); font-size: var(--fs-sm);">
                    @Localizer["NoMessagesYet"]
                </div>
            }
        </div>
    </div>

    <!-- Main Chat Area -->
    <div class="chat-area">

        <!-- Empty State -->
        <div id="chat-empty-state" style="display: @(activeConversationId > 0 ? "none" : "flex"); height: 100%; align-items: center; justify-content: center; flex-direction: column; color: var(--color-text-muted);">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: var(--space-3); opacity: 0.5;">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <p>@Localizer["SelectConversationToStart"]</p>
        </div>

        <!-- Active Chat State -->
        <div id="chat-active-state" style="display: @(activeConversationId > 0 ? "flex" : "none"); flex-direction: column; height: 100%; overflow: hidden;">

            <div class="chat-header">
                <div style="flex-grow: 1;">
                    <strong id="chat-header-name" style="font-size: var(--fs-md); display: block;">Localizer["Name"]</strong>
                    <span id="chat-header-listing" style="font-size: 12px; color: var(--color-text-muted);">@Localizer["Listing"]</span>
                </div>
            </div>

            <div class="chat-messages" id="chat-messages-container"></div>

            <div class="chat-input-area">
                <input type="hidden" id="current-conversation-id" value="@activeConversationId" />
                <input type="hidden" id="current-receiver-id" value="" />

                <input type="text" id="chat-message-input" class="chat-input" placeholder="@Localizer["TypeMessage"]" onkeypress="handleEnterKeyPress(event)" />

                <button type="button" class="send-btn" onclick="sendChatMessage()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const currentUserId = @currentUserId;
        let activeConvId = @activeConversationId;

        const hubConnection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/chat")
            .build();

        hubConnection.start().then(() => {
            if (activeConvId > 0) {
                let activeItem = document.querySelector(`.conversation-item[data-id='${activeConvId}']`);
                if (activeItem) {
                    loadConversation(activeConvId, activeItem);
                }
            }
        }).catch(err => console.error(err));

        hubConnection.on("ReceiveMessage", function (message) {
            if (activeConvId === message.conversationId) {
                appendMessageToUI(message);
                scrollToBottom();
            }

            let snippetEl = document.getElementById(`snippet-${message.conversationId}`);
            if (snippetEl) {
                snippetEl.innerText = message.content;
            }
        });

        function loadConversation(convId, element) {
            if (activeConvId > 0 && activeConvId !== convId) {
                hubConnection.invoke("LeaveConversation", activeConvId).catch(err => console.error(err));
            }

            activeConvId = convId;

            document.querySelectorAll('.conversation-item').forEach(el => el.classList.remove('active'));
            element.classList.add('active');

            let badge = document.getElementById(`badge-${convId}`);
            if (badge) badge.style.display = 'none';

            document.getElementById('chat-header-name').innerText = element.getAttribute('data-other-name');
            document.getElementById('chat-header-listing').innerText = element.getAttribute('data-listing-title');
            document.getElementById('current-conversation-id').value = convId;
            document.getElementById('current-receiver-id').value = element.getAttribute('data-other-id');

            document.getElementById('chat-empty-state').style.display = 'none';
            document.getElementById('chat-active-state').style.display = 'flex';

            fetch(`/Chat/GetMessages?conversationId=${convId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const container = document.getElementById('chat-messages-container');
                        container.innerHTML = '';

                        data.messages.forEach(msg => {
                            appendMessageToUI(msg);
                        });

                        scrollToBottom();
                        hubConnection.invoke("JoinConversation", convId).catch(err => console.error(err));
                    }
                });
        }

        function appendMessageToUI(message) {
            const container = document.getElementById('chat-messages-container');
            const isSentByMe = message.senderId === currentUserId;

            const msgDiv = document.createElement('div');
            msgDiv.className = `message-bubble ${isSentByMe ? 'message-sent' : 'message-received'}`;

            let dateString = message.createdAt;
            if (dateString && !dateString.includes('Z') && !dateString.includes('+')) {
                dateString += 'Z';
            }

            const dateObj = new Date(dateString);
            const timeStr = dateObj.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            msgDiv.innerHTML = `
                        <div>${message.content}</div>
                        <div class="message-time">${timeStr}</div>
                    `;

            container.appendChild(msgDiv);
        }

        function scrollToBottom() {
            const container = document.getElementById('chat-messages-container');
            container.scrollTop = container.scrollHeight;
        }

        function sendChatMessage() {
            const input = document.getElementById('chat-message-input');
            const content = input.value.trim();
            const convId = parseInt(document.getElementById('current-conversation-id').value);
            const receiverId = parseInt(document.getElementById('current-receiver-id').value);

            if (!content || !convId || !receiverId) return;

            input.value = '';

            hubConnection.invoke("SendMessage", convId, receiverId, content)
                .catch(err => {
                    console.error("Error sending message:", err);
                    alert("@Localizer["FailedToSendMessage"]");
                });
        }

        function handleEnterKeyPress(event) {
            if (event.key === "Enter") {
                event.preventDefault();
                sendChatMessage();
            }
        }
    </script>
}